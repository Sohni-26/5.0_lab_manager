# PostgreSQL Connection String
DATABASE_URL="postgresql://campuslab:campuslab_dev_password@localhost:5432/campuslab?schema=public"

# Authentication Configuration
AUTH_PROVIDER="mock"
AUTH_SESSION_SECRET="dev-only-campuslab-session-secret-change-in-production-32chars"
ENABLE_MOCK_AUTH="true"

# Supabase Storage & Realtime (Optional - falls back to local storage & SSE in development)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lab-item-photos"

# App Environment
NEXT_PUBLIC_APP_NAME="CampusLab"
NEXT_PUBLIC_ENABLE_MOCK_AUTH="true"
